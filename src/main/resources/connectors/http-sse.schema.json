{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data2flow.java21.net/schemas/connectors/http-sse-1.0.0.json",
  "title": "HTTP SSE 스트림",
  "description": "text/event-stream을 구독해 data 하나를 원본 하나로 넘긴다. 기록(confirm) 뒤 마지막 이벤트 id를 저장하고 다시 연결할 때 Last-Event-ID로 이어 받는다(CURSOR). id가 없는 서버는 유실 가능.",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": {"type": "string", "pattern": "^https?://\\S+$"},
    "headers": {"type": "object", "additionalProperties": {"type": "string"}},
    "topic": {"type": "string", "description": "event 이름이 없을 때 RawEnvelope.topic. 비우면 URL 경로"},
    "batchSize": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
    "auth": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["NONE", "BASIC", "BEARER", "API_KEY", "OAUTH2_CC"], "default": "NONE"},
        "username": {"type": "string"}, "headerName": {"type": "string"},
        "tokenUrl": {"type": "string"}, "clientId": {"type": "string"}, "scope": {"type": "string"}
      }
    },
    "tlsInsecure": {"type": "boolean", "default": false}
  },
  "x-ui": {"tabs": [{"name": "connection", "fields": ["url", "headers", "topic", "batchSize"]}, {"name": "security", "fields": ["auth", "tlsInsecure"]}]}
}
