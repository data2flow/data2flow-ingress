<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>net.java21.data2flow</groupId>
    <artifactId>data2flow-ingress</artifactId>
    <version>${revision}</version>
    <name>data2flow-ingress</name>
    <description>외부 MQTT 구독, Webhook·엣지 수신 → RabbitMQ data2flow.raw 스트림 기록(confirm 후 ACK) (DSC-01/02, ING-01)</description>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <!-- 보안 패치(2026-10-03 Trivy): Boot 기본값의 취약 버전을 고친 버전으로 올린다. Boot 다음 패치가 같은 버전 이상을 담으면 지운다
             tomcat 11.0.24 → CVE-2026-65182·65905·68525(CRITICAL), jackson 3.1.5 → CVE-2026-89407·89425·68497·91776·91777(HIGH) -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <data2flow-contracts.version>0.1.0-SNAPSHOT</data2flow-contracts.version>
        <!-- WebSocket 전송 모듈은 data2flow-bom이 관리하지 않으므로 BOM의 hivemq-mqtt-client 버전과 같은 값을 여기 둔다 -->
        <hivemq-mqtt-client.version>1.3.17</hivemq-mqtt-client.version>
    </properties>

    <!-- data2flow-contracts·data2flow-bom은 GitHub Packages에 있다. 읽기에도 토큰이 필요하다(README 참고) -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/data2flow/data2flow-contracts</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.java21.data2flow</groupId>
                <artifactId>data2flow-bom</artifactId>
                <version>${data2flow-contracts.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>net.java21.data2flow</groupId>
            <artifactId>data2flow-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 내부 API 호출(core-api API-DSC-50) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- RabbitMQ AMQP: data2flow.config 설정 변경 수신, data2flow.events 상태 보고(EVT-DSC-02·03·09) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- RabbitMQ Stream: data2flow.raw Super Stream 발행·confirm(ING-01.01). MPL-2.0 / Apache-2.0(ADR-018), 버전은 Boot 관리 -->
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>stream-client</artifactId>
        </dependency>
        <!-- MQTT 3.1.1·5 수동 ACK(connectors.md §2 확정). Apache-2.0. 버전은 data2flow-bom -->
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client</artifactId>
        </dependency>
        <!-- MQTT over WebSocket(ws·wss, iot-data.java21.net). Apache-2.0 -->
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client-websocket</artifactId>
            <version>${hivemq-mqtt-client.version}</version>
            <type>pom</type>
        </dependency>
        <!-- 분산 추적(OPS-02.03): Micrometer Tracing + OpenTelemetry. 내보내기 주소를 설정해야 내보낸다. Apache-2.0 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 커넥터 계약 테스트 키트(AbstractConnectorContractTest), 공통 ArchUnit 규칙, 메시지 스키마 검사 -->
        <dependency>
            <groupId>net.java21.data2flow</groupId>
            <artifactId>data2flow-contracts-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- *IT: Mosquitto·RabbitMQ 3.13 Stream·nginx·Toxiproxy 컨테이너(공용 브로커·s3·s4에는 붙지 않는다, CLAUDE.md §5). Apache-2.0/MIT -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-toxiproxy</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- *IT는 failsafe로 verify 단계에서 실행(design/testing) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
                </executions>
            </plugin>
            <!-- 커버리지 80% 강제. 단위·통합 테스트 결과를 합쳐서 본다 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes><exclude>**/*Application.class</exclude></excludes>
                </configuration>
                <executions>
                    <execution><id>prepare</id><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>prepare-it</id><goals><goal>prepare-agent-integration</goal></goals></execution>
                    <execution>
                        <id>merge</id><phase>post-integration-test</phase><goals><goal>merge</goal></goals>
                        <configuration>
                            <fileSets><fileSet><directory>${project.build.directory}</directory><includes><include>*.exec</include></includes></fileSet></fileSets>
                            <destFile>${project.build.directory}/jacoco-all.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id><phase>verify</phase><goals><goal>report</goal></goals>
                        <configuration><dataFile>${project.build.directory}/jacoco-all.exec</dataFile></configuration>
                    </execution>
                    <execution>
                        <id>check</id><phase>verify</phase><goals><goal>check</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-all.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit></limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
